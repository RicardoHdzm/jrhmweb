{
  // Worker que sirve el sitio estático y expone el endpoint del formulario.
  // Este archivo manda sobre la configuración del dashboard.
  "name": "jrhmweb",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-19",
  "assets": {
    // Solo se publica lo que esté en public/. Todo lo demás (código del Worker,
    // README y sobre todo .git) queda fuera de la web.
    "directory": "./public",
    "binding": "ASSETS"
  },
  "ratelimits": [
    {
      // Antispam del formulario. El binding solo admite periodos de 10 o 60
      // segundos, asi que no se puede replicar el "5 cada 15 minutos" del
      // Express viejo: esto frena rafagas, no un goteo lento.
      "name": "CONTACT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 }
    }
  ],
  "vars": {
    // Estas dos viven aquí y no en el dashboard: son configuración, no
    // secretos, y así un despliegue no puede dejarlas vacías.
    //
    // NOTIFY_EMAIL apunta al buzón del propio dominio en vez de a una
    // dirección personal, para no meter un correo privado en un repo público.
    // Cloudflare Email Routing ya reenvía hello@jrhm.studio al destino real.
    "NOTIFY_EMAIL": "hello@jrhm.studio",
    "FROM_EMAIL": "JRHM Web Studio <hello@jrhm.studio>"
  },
  // Por defecto, "wrangler deploy" borra del Worker toda variable de texto
  // plano que no esté declarada aquí. Con esto respeta las que estén puestas
  // en el dashboard, que es donde viven RESEND_API_KEY, NOTIFY_EMAIL y
  // FROM_EMAIL. Sin esta línea, un despliegue dejaría al formulario sin
  // configuración y devolviendo 500.
  "keep_vars": true
}
