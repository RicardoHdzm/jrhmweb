# Puerto del servidor
PORT=3000

# Origen permitido para CORS (tu frontend). En producción, poné tu dominio real.
FRONTEND_ORIGIN=http://localhost:5500

# --- Configuración de email (Gmail como ejemplo) ---
# 1. Activá la verificación en 2 pasos en tu cuenta de Gmail
# 2. Generá una "contraseña de aplicación" en https://myaccount.google.com/apppasswords
# 3. Usá esa contraseña acá, NO tu contraseña normal de Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_contraseña_de_aplicacion

# A dónde llegan las notificaciones cuando alguien llena el formulario
NOTIFY_EMAIL=tu_correo@gmail.com
